require_tools() {
  # Plasma's environment is not a login shell's, and herdr installed by its
  # own script, mise or cargo is often not on that PATH.
  command -v herdr >/dev/null 2>&1 ||
    PATH="$HOME/.local/bin:$HOME/bin:$HOME/.local/share/mise/installs/herdr/latest:$HOME/.cargo/bin:/usr/local/bin:$PATH"
  local tool
  for tool in herdr jq; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is not installed"
  done
}

# ------------------------------------------------------------------ KWin

qdbus_bin() {
  local q
  for q in qdbus6 qdbus-qt6 qdbus; do
    command -v "$q" >/dev/null 2>&1 && { printf '%s' "$q"; return 0; }
  done
  return 1
}

# Run a KWin script and print what it print()ed after its tag.
#
# $1 is the script body; every occurrence of @TAG@ in it is replaced with a
# tag unique to this call, and the script must print one line starting with
# that tag when it is done. The line comes back from the journal (KWin logs
# script print() output there under the "js" category), and the script is
# unloaded only after it has been seen, so a KWin that runs scripts
# asynchronously still gets to finish.
kwin_script() {
  local body="$1" q
  q=$(qdbus_bin) || return 1
  command -v journalctl >/dev/null 2>&1 || return 1
  private_dir "$RUNTIME_DIR" || return 1

  local tag="herdrboard-$$-$RANDOM$RANDOM"
  local file="$RUNTIME_DIR/$tag.js"
  printf '%s\n' "${body//@TAG@/$tag}" > "$file" || return 1

  local since id out=""
  # Killed half way (plasmashell restarting, say), the script would otherwise
  # stay loaded in KWin and its file stay on disk.
  trap '"$q" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "$tag" >/dev/null 2>&1; rm -f -- "$file"' EXIT INT TERM
  since=$(( $(date +%s) - 1 ))
  id=$("$q" org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$file" "$tag" 2>/dev/null) || id=""
  if [[ $id =~ ^[0-9]+$ ]]; then
    "$q" org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run >/dev/null 2>&1 || true
    local i
    for ((i = 0; i < 40; i++)); do
      out=$(journalctl --user --quiet --no-pager -o cat --since "@$since" \
              _COMM=kwin_wayland _COMM=kwin_x11 QT_CATEGORY=js 2>/dev/null |
            grep -F -m1 -- "$tag " | head -c "$((WINDOWS_BYTE_CAP + 1))") || true
      [[ -n $out ]] && break
      sleep 0.05
    done
  fi
  "$q" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript "$tag" >/dev/null 2>&1 || true
  rm -f -- "$file"
  trap - EXIT INT TERM

  [[ -n $out ]] || return 1
  over_byte_cap "$out" "$WINDOWS_BYTE_CAP" && return 1
  printf '%s\n' "${out#"$tag "}"
}

# Every normal window, as "pid<TAB>id" lines. Only the pid and KWin's window id
# are asked for: no titles, so nothing about what is on screen lands in the
# journal.
readonly KWIN_LIST_JS='
(function () {
  var parts = [];
  var list = workspace.windowList();
  for (var i = 0; i < list.length; i++) {
    var w = list[i];
    if (!w.normalWindow || !(w.pid > 0)) continue;
    parts.push(w.pid + "=" + String(w.internalId));
  }
  print("@TAG@ " + parts.join(" "));
})();
'

kwin_windows() {
  local out pair
  out=$(kwin_script "$KWIN_LIST_JS") || return 1
  for pair in $out; do
    [[ $pair =~ ^([0-9]+)=(\{[0-9a-fA-F-]+\})$ ]] || continue
    printf '%s\t%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  done
}

# Bring a window up: onto its virtual desktop, out of minimised, active.
kwin_activate() {
  local id="$1" out
  valid_window_id "$id" || return 1
  local js='
(function () {
  var want = "'"$id"'";
  var list = workspace.windowList();
  for (var i = 0; i < list.length; i++) {
    var w = list[i];
    if (String(w.internalId) !== want) continue;
    if (w.minimized) w.minimized = false;
    var desks = w.desktops || [];
    var cur = workspace.currentDesktop;
    var here = false;
    for (var d = 0; d < desks.length; d++) if (desks[d].id === cur.id) here = true;
    if (!w.onAllDesktops && desks.length > 0 && !here)
      workspace.currentDesktop = desks[0];
    workspace.activeWindow = w;
    print("@TAG@ ok");
    return;
  }
  print("@TAG@ missing");
})();
'
  out=$(kwin_script "$js") || return 1
  [[ $out == ok ]]
}

# ---------------------------------------------------------------- windows

# Read a session (and remote target) out of a process command line, when that
# process is a herdr client: argv[0] is herdr and everything after it is a
# flag (`--session <name>`, `--session=<name>`, `--remote <target>`, ...).
# `herdr server`, `herdr api ...` are not clients, and neither is `man herdr`,
# `vim herdr` or `ssh box herdr`: only argv[0] counts.
#
# Answers in $found_session/$found_target instead of stdout: this runs once per
# herdr-looking process and a command substitution would fork each time.
session_in_args() {
  found_session=""
  found_target=""
  local -a words
  read -r -a words <<<"${1-}"
  (( ${#words[@]} > 0 )) || return 1
  [[ ${words[0]##*/} == herdr ]] || return 1
  local j name=default target=""
  for ((j = 1; j < ${#words[@]}; j++)); do
    case ${words[j]} in
      --session) name=${words[j + 1]-}; j=$((j + 1)) ;;
      --session=*) name=${words[j]#--session=} ;;
      --remote) target=${words[j + 1]-}; j=$((j + 1)) ;;
      --remote=*) target=${words[j]#--remote=} ;;
      -*) ;;
      *) return 1 ;;
    esac
  done
  valid_session_name "$name" || return 1
  [[ -z $target ]] || valid_machine_target "$target" || return 1
  found_session=$name
  found_target=$target
  return 0
}

# One step up the process tree, read from /proc. The comm field is bracketed
# and may hold spaces, so the line is cut after the closing bracket first.
parent_pid() {
  local line rest
  { read -r line < "/proc/$1/stat"; } 2>/dev/null || return 1
  rest=${line##*") "}
  # shellcheck disable=SC2086
  set -- $rest
  [[ ${2-} =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$2"
}

# Which KWin window is showing which session.
#
# A herdr client is a process whose command line is `herdr` followed by flags
# only (`--session <name>`, `--remote <target>`); `herdr server`, `herdr api
# ...` and the like are not clients. Each client is walked up the process tree
# until a pid that owns a window turns up: that is the terminal showing it.
#
# A terminal that runs every window in one process (kitty --single-instance,
# konsole in single-process mode) gives several windows one pid, and the pid
# alone cannot say which of them holds herdr. Such pids are skipped rather
# than guessed at, so "open" starts a fresh window instead of raising the wrong
# one. Windows Herdrboard opens itself are started with `konsole --separate`.
#
# Prints "ssh-target<TAB>session<TAB>window-id" per line; the target is empty
# for a local server.
window_map() {
  local windows
  windows=$(kwin_windows) || return 0
  [[ -n $windows ]] || return 0

  declare -A window_of_pid=() windows_per_pid=()
  local pid id
  while IFS=$'\t' read -r pid id; do
    [[ -n $pid && -n $id ]] || continue
    window_of_pid[$pid]=$id
    windows_per_pid[$pid]=$(( ${windows_per_pid[$pid]-0} + 1 ))
  done <<<"$windows"
  ((${#window_of_pid[@]})) || return 0

  declare -A args_of=()
  local args
  while read -r pid args; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    args_of[$pid]=$args
  done < <(ps -eo pid=,args= 2>/dev/null | grep -E 'her[d]r' || true)

  declare -A emitted=()
  local found_session="" found_target=""

  local ancestor hops
  for pid in "${!args_of[@]}"; do
    session_in_args "${args_of[$pid]}" || continue
    [[ -n ${emitted[$found_target/$found_session]-} ]] && continue
    ancestor=$pid
    for ((hops = 0; hops < 12; hops++)); do
      if [[ -n ${window_of_pid[$ancestor]-} ]]; then
        if (( ${windows_per_pid[$ancestor]} == 1 )); then
          emitted[$found_target/$found_session]=1
          printf '%s\t%s\t%s\n' "$found_target" "$found_session" "${window_of_pid[$ancestor]}"
        fi
        break
      fi
      ancestor=$(parent_pid "$ancestor") || break
      [[ -n $ancestor && $ancestor != 0 && $ancestor != 1 ]] || break
    done
  done
}

# ---------------------------------------------------------------- listing

# One session's agents and workspaces, from its own server. `--session` is left
# off for the default one: by name it would address a *named* session that
# happens to be called "default", which is a different server.
snapshot_for() {
  local name="$1" is_default="$2" out
  if [[ $is_default == true ]]; then
    out=$(hd api snapshot 2>/dev/null | head -c "$((SNAPSHOT_BYTE_CAP + 1))") || true
  else
    out=$(hd --session "$name" api snapshot 2>/dev/null | head -c "$((SNAPSHOT_BYTE_CAP + 1))") || true
  fi
  [[ -n $out ]] || return 1
  over_byte_cap "$out" "$SNAPSHOT_BYTE_CAP" && return 1
  printf '%s' "$out"
}

# The answer is spliced into a larger document as text, so it must be exactly
# one JSON document: `jq -e` alone judges only the last of several.
is_one_snapshot() {
  printf '%s' "$1" | jq -se 'length == 1 and (.[0].result.snapshot | type == "object")' >/dev/null 2>&1
}

# Session rows from a session list plus its servers' snapshots: the one place
# that turns what herdr says into what the widget draws. Inputs arrive on stdin
# one after the other (session list, snapshots keyed by name, saved labels of
# stopped sessions), not through --argjson, because one argv string is capped
# at 128 KiB and a busy snapshot is bigger than that.
readonly ROWS_JQ='
    input as $snapshots
    | input as $saved
    | [.sessions[]?
       | .name as $name
       | (($snapshots[$name].result.snapshot) // {}) as $snap
       | ($snap.agents // []) as $agents
       | (($snap.workspaces // [])
          | map({key: (.workspace_id // ""), value: (.label // "")})
          | from_entries) as $wslabels
       # An unnamed tab comes back labelled with its number; that is not a
       # name worth printing, so those join as empty.
       | (($snap.tabs // [])
          | map({key: (.tab_id // ""),
                 value: (if (.label // "") == ((.number // "") | tostring)
                         then "" else (.label // "") end)})
          | from_entries) as $tablabels
       | {
           name: $name,
           isDefault: (.default // false),
           running: (.running // false),
           version: ($snap.version // ""),
           error: (if (.running // false) then ($snapshots[$name].herdrboardError // "") else "" end),
           agents: ($agents | length),
           working: ([$agents[] | select(.agent_status == "working")] | length),
           blocked: ([$agents[] | select(.agent_status == "blocked")] | length),
           idle:    ([$agents[] | select(.agent_status == "idle")] | length),
           done:    ([$agents[] | select(.agent_status == "done")] | length),
           workspaces: (($snap.workspaces // []) | length),
           agentList: ($agents
                       # `//` only skips null and false, and an empty stripped
                       # title is common; an untitled agent still gets a row.
                       | map({title: ([.terminal_title_stripped, .terminal_title, .agent]
                                      | map(select(type == "string" and . != "")) | .[0] // ""),
                              # The agent kind herdr detected (claude, codex, ...).
                              kind: (.agent // ""),
                              status: (.agent_status // "unknown"),
                              pane: (.pane_id // ""),
                              workspace: ($wslabels[.workspace_id // ""] // ""),
                              tab: ($tablabels[.tab_id // ""] // ""),
                              seq: (.state_change_seq // 0)})
                       # The attention order herdr uses itself: wants an answer,
                       # finished unseen, busy, waiting for input. Stable sort.
                       | sort_by(if   .status == "blocked" then 0
                                 elif .status == "done"    then 1
                                 elif .status == "working" then 2
                                 elif .status == "idle"    then 3
                                 else 4 end)
                       | .[0:$agentCap]),
           projects: (if (.running // false)
                      then (($snap.workspaces // []) | map(.label // "")
                            | map(select(length > 0)) | unique)
                      else ($saved[$name] // []) end)
         }]
    | {ok: true, error: "", sessions: .}
  '

# This host's sessions. Windows are joined later, in cmd_list: which window
# shows a session is a fact about this desktop, not about the session's host.
collect_sessions() {
  local sessions_json
  sessions_json=$(hd session list --json 2>/dev/null | head -c "$((SESSIONS_BYTE_CAP + 1))") || true
  [[ -n $sessions_json ]] || die "could not reach herdr"
  over_byte_cap "$sessions_json" "$SESSIONS_BYTE_CAP" && die "session list too large to read safely"

  # Snapshots are assembled as text, one name-keyed object, because a jq start
  # per session would cost more than the rest of the poll. The key is safe to
  # splice in: valid_session_name allows letters, digits, dot, dash, underscore.
  #
  # A stopped session has no server to ask, but herdr keeps its layout in
  # session.json, which still names its workspaces: that is what makes a
  # stopped row say what it is holding.
  local snapshots='' saved='' name is_default running dir snap labels
  local seen=0
  while IFS=$'\t' read -r name is_default running dir; do
    [[ -n $name ]] || continue
    valid_session_name "$name" || continue
    (( seen < SESSION_COUNT_CAP )) || continue
    (( ${#snapshots} + ${#saved} <= TOTAL_BYTE_CAP )) || continue
    seen=$(( seen + 1 ))

    if [[ $running == true ]]; then
      # A server that does not answer, or answers with something that is not
      # a snapshot, gets an error on its own row; the others still count.
      if snap=$(snapshot_for "$name" "$is_default") &&
         is_one_snapshot "$snap"; then
        snapshots+="${snapshots:+,}\"$name\":$snap"
      else
        snapshots+="${snapshots:+,}\"$name\":{\"herdrboardError\":\"no answer from this server\"}"
      fi
      continue
    fi

    readable_file "$dir/session.json" || continue
    over_byte_cap "$(head -c "$((SESSION_FILE_CAP + 1))" -- "$dir/session.json" 2>/dev/null || true)" \
      "$SESSION_FILE_CAP" && continue
    labels=$(jq -sc --arg home "$HOME" 'if length == 1 then .[0] else error end
                    | [.workspaces[]?
                     | (.custom_name
                        // (if (.identity_cwd // "") == $home then "~"
                            else (.identity_cwd // "" | split("/") | last) end))
                     | select(. != null and . != "")]
                    | unique' -- "$dir/session.json" 2>/dev/null) || continue
    [[ -n $labels ]] || continue
    saved+="${saved:+,}\"$name\":$labels"
  done < <(printf '%s' "$sessions_json" |
    jq -r '.sessions[]? | "\(.name)\t\(.default // false)\t\(.running // false)\t\(.session_dir // "")"')
  snapshots="{$snapshots}"
  saved="{$saved}"

  printf '%s\n%s\n%s\n' "$sessions_json" "$snapshots" "$saved" | jq -c \
    --argjson agentCap "$AGENT_COUNT_CAP" \
    "$ROWS_JQ" 2>/dev/null || die "unexpected output from herdr"
}

# ------------------------------------------------------ saved SSH machines

# Enabled machines from `herdr machine list`. Any problem (an older herdr, an
# unreadable catalog, an oversized reply) means an empty list, never an error:
# local sessions are what every install stands on.
machine_list() {
  local out
  out=$(hd machine list --json 2>/dev/null | head -c "$((MACHINES_BYTE_CAP + 1))") || true
  [[ -n $out ]] || { printf '[]'; return 0; }
  over_byte_cap "$out" "$MACHINES_BYTE_CAP" && { printf '[]'; return 0; }
  printf '%s' "$out" | jq -c '
    if type != "array" then [] else
      [.[] | select(type == "object" and .enabled == true)
       | {id: (.id // ""), label: (.label // ""), target: (.target // ""),
          # A profile points at one session on the far end, the only one
          # `--machine` routing can reach.
          session: (.session // "default")}
       | select(.id != "" and .target != "")
       | .label |= gsub("[\\t\\r\\n]+"; " ")]
    end' 2>/dev/null || printf '[]'
}

# The ssh target behind a machine id, from the live catalog.
machine_target() {
  valid_machine_id "${1-}" || return 1
  local target
  target=$(machine_list | jq -r --arg id "$1" \
    '.[] | select(.id == $id) | .target' 2>/dev/null)
  [[ -n $target ]] && valid_machine_target "$target" || return 1
  printf '%s' "$target"
}

# `herdr --machine` routing landed in 0.9.1.
remote_floor_met() {
  local v
  v=$(hd --version 2>/dev/null) || return 1
  v=${v#herdr }
  [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  [[ $(printf '%s\n' "$v" 0.9.1 | sort -V | head -1) == 0.9.1 ]]
}

# One machine's profile session, through the same ROWS_JQ as local rows behind
# a faked one-row session list. Under `timeout` so a quiet network cannot hold
# the poll; herdr's stderr is kept as the reason shown when it fails.
machine_rows() {
  local mid="$1" msession="$2" errlog="$3" out
  valid_session_name "$msession" || return 1
  out=$(timeout --signal=TERM -k 1 10 herdr --machine "$mid" api snapshot \
    2>"$errlog" < /dev/null | head -c "$((SNAPSHOT_BYTE_CAP + 1))") || true
  [[ -n $out ]] || return 1
  over_byte_cap "$out" "$SNAPSHOT_BYTE_CAP" && return 1
  is_one_snapshot "$out" || return 1
  {
    jq -nc --arg name "$msession" \
      '{sessions: [{name: $name, default: ($name == "default"), running: true, session_dir: ""}]}'
    printf '{"%s":%s}\n{}\n' "$msession" "$out"
  } | jq -c --argjson agentCap "$AGENT_COUNT_CAP" "$ROWS_JQ" 2>/dev/null
}

# herdr prints its error inside a Rust error wrapper; unwrap it for the UI.
machine_error() {
  local errlog="$1" err
  err=$(sed -n 's/^Error: Custom { kind: [^,]*, error: "\(.*\)" }$/\1/p' \
    "$errlog" 2>/dev/null | head -1) || true
  [[ -n $err ]] || err=$(tr '[:cntrl:]' ' ' < "$errlog" 2>/dev/null | head -c 200) || true
  err=${err%$'\n'}
  printf '%s' "${err:-unreachable}"
}

cmd_list() {
  local with_windows=1
  [[ ${1-} == --no-windows ]] && with_windows=0

  local local_json
  local_json=$(collect_sessions)
  if [[ $(printf '%s' "$local_json" | jq -r '.ok // false' 2>/dev/null) != true ]]; then
    local local_err
    local_err=$(printf '%s' "$local_json" | jq -rj '.error // ""' 2>/dev/null) || true
    die "${local_err:-could not reach herdr}"
  fi

  local machines_json
  machines_json=$(machine_list)

  # Only worth asking KWin when some server is running: a stopped session has
  # no client and so no window.
  local windows=""
  if (( with_windows )) &&
     [[ $(printf '%s' "$local_json" | jq '[.sessions[] | select(.running)] | length') != 0 ||
        $machines_json != '[]' ]]; then
    windows=$(window_map || true)
  fi

  # Machines are asked in parallel, each answer in a file of its own, so a
  # stalled dial cannot hold the others hostage.
  local remote='' status_tsv='' mid mlabel mtarget msession
  if [[ $machines_json != '[]' ]]; then
    private_dir "$RUNTIME_DIR" || die "could not use the runtime directory"
    local tmpdir
    tmpdir=$(mktemp -d "$RUNTIME_DIR/list.XXXXXX") || die "could not use the runtime directory"
    trap "rm -rf -- $(printf '%q' "$tmpdir")" EXIT

    if remote_floor_met; then
      local -a pids=()
      while IFS=$'\t' read -r mid mlabel mtarget msession; do
        [[ -n $mid ]] || continue
        valid_machine_id "$mid" || continue
        valid_machine_target "$mtarget" || continue
        (
          if rows=$(machine_rows "$mid" "$msession" "$tmpdir/$mid.errlog") \
            && [[ $(printf '%s' "$rows" | jq -r '.ok // false' 2>/dev/null) == true ]]; then
            printf '%s' "$rows" > "$tmpdir/$mid.json"
          else
            machine_error "$tmpdir/$mid.errlog" > "$tmpdir/$mid.err"
          fi
          rm -f -- "$tmpdir/$mid.errlog"
        ) &
        pids+=($!)
      done < <(printf '%s' "$machines_json" | jq -r '.[] | "\(.id)\t\(.label)\t\(.target)\t\(.session)"')
      ((${#pids[@]} == 0)) || wait "${pids[@]}" 2>/dev/null || true
    else
      while IFS=$'\t' read -r mid _ _ _; do
        [[ -n $mid ]] || continue
        valid_machine_id "$mid" || continue
        printf 'needs herdr 0.9.1 or newer' > "$tmpdir/$mid.err"
      done < <(printf '%s' "$machines_json" | jq -r '.[] | "\(.id)\t\(.label)\t\(.target)\t\(.session)"')
    fi

    local err
    while IFS=$'\t' read -r mid mlabel mtarget; do
      [[ -n $mid ]] || continue
      valid_machine_id "$mid" || continue
      if [[ -f $tmpdir/$mid.json ]]; then
        remote+="${remote:+,}\"$mid\":$(cat -- "$tmpdir/$mid.json")"
        status_tsv+="$mid"$'\t'"$mlabel"$'\t'"$mtarget"$'\t1\t'$'\n'
      else
        err=unreachable
        [[ -f $tmpdir/$mid.err ]] && err=$(tr '[:cntrl:]' ' ' < "$tmpdir/$mid.err")
        status_tsv+="$mid"$'\t'"$mlabel"$'\t'"$mtarget"$'\t0\t'"$err"$'\n'
      fi
    done < <(printf '%s' "$machines_json" | jq -r '.[] | "\(.id)\t\(.label)\t\(.target)"')
  fi
  remote="{$remote}"
  printf '%s' "$remote" | jq -e . >/dev/null 2>&1 || remote='{}'

  local machines_with_status
  machines_with_status=$(printf '%s' "$status_tsv" | jq -Rn \
    '[inputs | split("\t")
      | {id: .[0], label: .[1], target: .[2], ok: (.[3] == "1"),
         error: (.[4] // "")}]') || machines_with_status='[]'

  printf '%s\n%s\n%s\n' "$local_json" "$machines_with_status" "$remote" | jq -c \
    --arg windows "$windows" '
    . as $local
    | input as $machines
    | input as $remote
    | ($windows | split("\n") | map(select(length > 0) | split("\t"))
      | map({key: (.[0] + "\u0000" + .[1]), value: .[2]}) | from_entries) as $win
    | ($machines | map({key: .id, value: .}) | from_entries) as $mach
    | ([ $local.sessions[]
         | . + {machineId: "", machineLabel: "", sshTarget: "", remote: false} ]
       + [ $machines[] | select(.ok) | .id as $mid
           | ($remote[$mid].sessions // [])[]
           | . + {machineId: $mid,
                  machineLabel: ($mach[$mid].label // ""),
                  sshTarget: ($mach[$mid].target // ""),
                  remote: true} ])
    | map(. + {windowId: ($win[(.sshTarget + "\u0000" + .name)] // "")})
    | sort_by([(if .machineId == "" then 0 else 1 end),
               (.machineLabel | ascii_downcase),
               (if .isDefault then 0 else 1 end),
               (if .running then 0 else 1 end),
               (.name | ascii_downcase)])
    | {ok: true,
       error: "",
       machines: $machines,
       sessions: .,
       running: ([.[] | select(.running)] | length),
       agents: ([.[] | .agents] | add // 0),
       blocked: ([.[] | .blocked] | add // 0),
       done: ([.[] | .done] | add // 0),
       working: ([.[] | .working] | add // 0)}
  ' 2>/dev/null || die "unexpected output from herdr"
}

# ------------------------------------------------------------- terminal

# The user's terminal, as words: what System Settings > Default Applications >
# Terminal wrote to kdeglobals (TerminalApplication, a command line; or
# TerminalService, a .desktop file whose Exec is used), then
# xdg-terminal-exec, then Konsole (KDE's own default when nothing is set).
# The value is split into words, never evaluated by a shell. Prints one word
# per line; returns 1 when nothing usable is found.
terminal_words() {
  local -a words=()
  local value=""
  if command -v kreadconfig6 >/dev/null 2>&1; then
    value=$(kreadconfig6 --file kdeglobals --group General --key TerminalApplication 2>/dev/null) || value=""
  fi
  if [[ -n $value ]]; then
    read -r -a words <<<"$value"
    if (( ${#words[@]} )) && command -v -- "${words[0]}" >/dev/null 2>&1; then
      printf '%s\n' "${words[@]}"
      return 0
    fi
  fi

  local service=""
  if command -v kreadconfig6 >/dev/null 2>&1; then
    service=$(kreadconfig6 --file kdeglobals --group General --key TerminalService 2>/dev/null) || service=""
  fi
  if [[ $service =~ ^[A-Za-z0-9._-]+\.desktop$ ]]; then
    local dir file exec_line=""
    local IFS_SAVE=$IFS
    IFS=:
    for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
      file="$dir/applications/$service"
      if readable_file "$file"; then
        exec_line=$(sed -n '/^\[Desktop Entry\]/,/^\[/{s/^Exec=//p}' -- "$file" | head -1)
        break
      fi
    done
    IFS=$IFS_SAVE
    # Exec quoting rules are not reimplemented: a quoted or escaped Exec is
    # skipped rather than split wrongly.
    if [[ -n $exec_line && $exec_line != *[\"\'\\]* ]]; then
      read -r -a words <<<"$exec_line"
      local -a kept=()
      local w
      for w in "${words[@]}"; do
        [[ $w =~ ^%[a-zA-Z]$ ]] && continue
        kept+=("${w//%%/%}")
      done
      if (( ${#kept[@]} )) && command -v -- "${kept[0]}" >/dev/null 2>&1; then
        printf '%s\n' "${kept[@]}"
        return 0
      fi
    fi
  fi

  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    printf '%s\n' xdg-terminal-exec
    return 0
  fi
  if command -v konsole >/dev/null 2>&1; then
    printf '%s\n' konsole
    return 0
  fi
  return 1
}

# Fill the caller's `launch` array: the terminal plus how that terminal is
# told to run a program, plus the program ($1). Unknown terminals get `-e`,
# the xterm convention most of them follow.
launch_argv() {
  local program="$1" line
  local -a term=()
  while IFS= read -r line; do term+=("$line"); done < <(terminal_words)
  (( ${#term[@]} )) || return 1

  local -a run=("$program")
  [[ -x $program ]] || run=(bash "$program")

  case ${term[0]##*/} in
    konsole)
      # A window of its own process, so the window lookup (one pid, one
      # window) can tell it apart from the user's other Konsole windows.
      local w has=0
      for w in "${term[@]}"; do [[ $w == --separate || $w == --nofork ]] && has=1; done
      (( has )) || term+=(--separate)
      launch=("${term[@]}" -e "${run[@]}") ;;
    gnome-terminal|kgx|ptyxis|tilix|xfce4-terminal|mate-terminal)
      launch=("${term[@]}" -- "${run[@]}") ;;
    wezterm|wezterm-gui)
      if [[ ${term[1]-} == start ]]; then launch=("${term[@]}" -- "${run[@]}")
      else launch=("${term[@]}" start -- "${run[@]}"); fi ;;
    foot|footclient|kitty|xdg-terminal-exec)
      launch=("${term[@]}" "${run[@]}") ;;
    *)
      # konsole-style and xterm-style: alacritty, xterm, urxvt, ghostty, st...
      launch=("${term[@]}" -e "${run[@]}") ;;
  esac
}

# ------------------------------------------------------------- open a session

# Raise the window showing a session, or start one. A session shows at most one
# window (two windows on one session mirror each other), so a new terminal is
# only started when none is found. Returns 1 when no terminal could be started.
show_session() {
  local name="$1" target="${2-}" id

  id=$(window_map | awk -F'\t' -v want_t="$target" -v want="$name" \
    '$1 == want_t && $2 == want { print $3; exit }') || id=""
  if [[ -n $id ]] && kwin_activate "$id"; then
    return 0
  fi

  # `herdr --session <name>` attaches to a running server and starts one when
  # there is none, so one command covers both. `--remote` is the attach form
  # for a session on another machine. Both arrive in herdrboard-attach through
  # the environment (see that file for why).
  local session_arg=""
  [[ $name == default ]] || session_arg=$name

  local -a launch=()
  launch_argv "$SCRIPT_DIR/herdrboard-attach" || return 1

  (
    umask "$INHERITED_UMASK"
    if [[ -n $INHERITED_LC_ALL_SET ]]; then export LC_ALL=$INHERITED_LC_ALL; else unset LC_ALL; fi
    export HERDRBOARD_REMOTE="$target" HERDRBOARD_SESSION="$session_arg"
    cd "$HOME" && exec setsid "${launch[@]}"
  ) </dev/null >/dev/null 2>&1 &
  disown
  return 0
}

cmd_open() {
  local name="${1-}" machine="${2-}" target=""
  valid_session_name "$name" || die "not a session name"
  if [[ -n $machine ]]; then
    target=$(machine_target "$machine") || die "no such machine"
  fi
  show_session "$name" "$target" || die "no terminal available"
  printf '{"ok":true}\n'
}

# Land on one agent: its pane is focused inside the server first (which also
# switches workspace and tab there, and marks a "done" agent as seen), then the
# window comes up. Works on a windowless session too: the server moves first,
# and the new window attaches to where it is.
cmd_focus() {
  local name="${1-}" pane="${2-}" machine="${3-}" target=""
  valid_session_name "$name" || die "not a session name"
  valid_pane_id "$pane" || die "not a pane id"

  if [[ -n $machine ]]; then
    target=$(machine_target "$machine") || die "no such machine"
    timeout --signal=TERM -k 1 15 herdr --machine "$machine" agent focus "$pane" >/dev/null 2>&1 < /dev/null || true
  elif [[ $name == default ]]; then
    hd agent focus "$pane" >/dev/null 2>&1 || true
  else
    hd --session "$name" agent focus "$pane" >/dev/null 2>&1 || true
  fi

  show_session "$name" "$target" || die "no terminal available"
  printf '{"ok":true}\n'
}

# ------------------------------------------------------------ kill / delete

# Which process serves a session. Every server has the same command line
# (`herdr server`), so the socket it listens on is what tells them apart, and
# `ss` maps a listening unix socket back to its process.
server_pid_for() {
  local socket="$1" pid
  [[ -n $socket ]] || return 1
  command -v ss >/dev/null 2>&1 || return 1
  # The local address column compared whole, not as a substring.
  pid=$(ss -lpxnH 2>/dev/null | awk -v want="$socket" '
    $5 == want && match($0, /pid=[0-9]+/) { print substr($0, RSTART + 4, RLENGTH - 4); exit }')
  [[ $pid =~ ^[0-9]+$ ]] || return 1

  # Checked again before signalling: it must still be a herdr server.
  local comm=""
  { read -r comm < "/proc/$pid/comm"; } 2>/dev/null || return 1
  [[ $comm == herdr ]] || return 1
  grep -qz '^server$' "/proc/$pid/cmdline" 2>/dev/null || return 1
  printf '%s' "$pid"
}

socket_of() {
  hd session list --json 2>/dev/null |
    jq -r --arg name "$1" '.sessions[]? | select(.name == $name) | .socket_path // ""' 2>/dev/null
}

# A signal, not `herdr session stop`: that asks over the socket, and a server
# too wedged to read its socket never hears it. TERM first so it can close its
# sockets, KILL a second later if that was not enough.
cmd_kill() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  [[ -z ${2-} ]] || die "remote servers are not killed from here"

  local pid
  pid=$(server_pid_for "$(socket_of "$name")") || die "no running server for that session"

  kill -TERM "$pid" 2>/dev/null || true
  local i
  for ((i = 0; i < 10; i++)); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
  printf '{"ok":true}\n'
}

cmd_delete() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  [[ $name == default ]] && die "the default session is not deleted from here"
  [[ -z ${2-} ]] || die "remote sessions are not deleted from here"
  # The popup can be a poll behind: a session started since then still shows
  # as stopped, so ask herdr again before throwing its directory away.
  local running
  running=$(hd session list --json 2>/dev/null |
    jq -r --arg name "$name" '.sessions[]? | select(.name == $name) | .running // false' 2>/dev/null)
  [[ $running == false ]] || die "that session is running or unknown"
  hd session delete "$name" >/dev/null 2>&1 || die "herdr refused to delete that session"
  printf '{"ok":true}\n'
}

cmd_windows() {
  local map
  map=$(window_map || true)
  printf '%s' "$map" | jq -Rnc '[inputs | split("\t") | {target: .[0], session: .[1], windowId: .[2]}]'
}

# ------------------------------------------------------------------- main

# Sourced (by tests/script.test.sh): define the functions, run nothing.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
  return 0
fi

require_tools

# Every write is a no-op while the demo is on, so a click during a screenshot
# cannot reach a real session.
case "${1:-list}" in
  list) shift || true; if demo_on; then demo_list; else cmd_list "${1-}"; fi ;;
  open) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_open "${1-}" "${2-}"; fi ;;
  focus) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_focus "${1-}" "${2-}" "${3-}"; fi ;;
  kill) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_kill "${1-}" "${2-}"; fi ;;
  delete) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_delete "${1-}" "${2-}"; fi ;;
  windows) cmd_windows ;;
  demo) shift; cmd_demo "${1-}" ;;
  *) die "unknown command" ;;
esac
