{"name":"spike","isDefault":false,"running":false,"version":"","agents":0,"working":0,"blocked":0,"idle":0,"done":0,"workspaces":0,"projects":["parser-bench"],"agentList":[],"windowId":"","machineId":"","machineLabel":"","sshTarget":"","remote":false},
