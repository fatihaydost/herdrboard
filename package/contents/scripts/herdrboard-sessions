#!/bin/bash
# herdrboard-sessions: everything the Herdrboard widget needs to know about
# herdr, as one JSON object per call.
#
#   list [--no-windows]
#                 every session, running or stopped, here and on each enabled
#                 SSH machine from `herdr machine list`. --no-windows skips the
#                 KWin window lookup (the tray icon only needs the counts)
#   open <name> [machine]
#                 focus the window showing that session, or open one
#   focus <name> <pane> [machine]
#                 the same, but land on one agent's pane inside it first
#   kill <name>   signal the session's server until it is gone (local only)
#   delete <name> remove a stopped session's directory (local only)
#   windows       debug: the session -> window map this script sees
#   demo on|off   invented sessions instead of yours, for screenshots
#
# Herdr runs one server per named session. `herdr session list` says which
# exist; each running server answers `api snapshot` with its agents and
# workspaces. This script joins the two and, when asked, adds which KWin window
# is showing each session.
#
# Window lookup goes through KWin's scripting D-Bus API: a tiny script is
# loaded, run and unloaded, and it print()s the window list to KWin's log,
# which is read back from the systemd journal by a unique tag. Without KWin
# (or without a journal) every session simply looks windowless and "open"
# starts a new terminal.
#
# Everything below the session name comes from herdr: workspace labels are
# directory names, agent titles are whatever an agent wrote there. They are
# printed as JSON strings and drawn as plain text, never handed to a shell.
#
# A machine argument is a herdr machine profile id; the ssh target it stands
# for is read back from `herdr machine list`, never taken from the caller.

set -euo pipefail

# The terminal this script opens inherits the umask, and so does a herdr server
# started from it, and every shell inside that. Keep the caller's for that
# launch; everything this script writes itself is private.
readonly INHERITED_UMASK=$(umask)
umask 077

# The same goes for the locale: C for this script's own parsing, the caller's
# for the terminal it opens.
readonly INHERITED_LC_ALL_SET=${LC_ALL+1}
readonly INHERITED_LC_ALL=${LC_ALL-}
export LC_ALL=C

# Run from inside a herdr pane, these would point every herdr call (and a
# terminal opened from here, which herdr then refuses as nested) at the pane's
# own server. This script is always an outside client.
unset HERDR_ENV HERDR_SOCKET_PATH HERDR_PANE_ID HERDR_TAB_ID HERDR_WORKSPACE_ID

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/herdrboard"
readonly DEMO_FILE="$CACHE_DIR/demo"
readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/herdrboard-$(id -u)"

# Ceilings on what another process may hand this script. The widget polls it
# every few seconds for as long as Plasma runs, so the other side must not
# decide how much memory a poll costs.
readonly SESSIONS_BYTE_CAP=$((2 * 1024 * 1024))
readonly SNAPSHOT_BYTE_CAP=$((2 * 1024 * 1024))
readonly WINDOWS_BYTE_CAP=$((1 * 1024 * 1024))
readonly SESSION_FILE_CAP=$((1 * 1024 * 1024))
readonly TOTAL_BYTE_CAP=$((8 * 1024 * 1024))
readonly SESSION_COUNT_CAP=200
readonly AGENT_COUNT_CAP=500
readonly MACHINES_BYTE_CAP=$((256 * 1024))

die() {
  printf '{"ok":false,"error":%s,"sessions":[]}\n' "$(json_string "$1")"
  exit 0
}

json_string() {
  printf '%s' "${1-}" | jq -Rs .
}

# Whether a capped read came back at its ceiling (callers read cap+1 bytes, so
# the extra byte is the evidence). Measured instead of read off an exit
# status: under pipefail a `head` that closes early makes the pipeline fail.
over_byte_cap() {
  [ "$(printf '%s' "$1" | wc -c)" -gt "$2" ]
}

# Names, pane ids, machine ids and targets all come back from the widget as
# arguments, so their shape is checked before they reach a command line.
# Anything else is refused, never repaired.
valid_session_name() { [[ "${1-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }
valid_pane_id() { [[ "${1-}" =~ ^[A-Za-z0-9_-]{1,32}:[A-Za-z0-9_-]{1,32}$ ]]; }
valid_machine_id() { [[ "${1-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }
valid_machine_target() {
  # User and host start alphanumeric, so nothing here can read as an option.
  [[ "${1-}" =~ ^(ssh://)?([A-Za-z0-9][A-Za-z0-9._-]*@)?[A-Za-z0-9][A-Za-z0-9._-]*(:[0-9]{1,5})?$ ]]
}
# A KWin window id: a braced QUuid.
valid_window_id() {
  [[ "${1-}" =~ ^\{[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}$ ]]
}

# A directory someone else can write to can hand this script a symlink on a
# name it is about to write. Refuse what is not ours, tighten the rest.
private_dir() {
  local dir="$1" owner
  mkdir -p -m 700 -- "$dir" 2>/dev/null || true
  [[ -d $dir && ! -L $dir ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ $owner == "$(id -u)" ]] || return 1
  chmod 700 -- "$dir" 2>/dev/null || return 1
  # Leftovers of a call that was killed before it could clean up.
  find "$dir" -mindepth 1 -maxdepth 1 -name 'herdrboard-*.js' -mmin +1 -delete 2>/dev/null || true
  return 0
}

# Every local herdr call goes through this: a wedged server (the very case the
# kill button exists for) must not hang a poll, which would stop the widget
# refreshing until Plasma restarts.
readonly LOCAL_TIMEOUT=5
hd() {
  timeout --signal=TERM -k 1 "$LOCAL_TIMEOUT" herdr "$@" < /dev/null
}

readable_file() { [[ -f "$1" && ! -L "$1" ]]; }

demo_on() { readable_file "$DEMO_FILE"; }

cmd_demo() {
  case "${1-}" in
    on)
      private_dir "$CACHE_DIR" || die "could not use the cache directory"
      : > "$DEMO_FILE"
      printf '{"ok":true,"demo":true}\n'
      ;;
    off)
      rm -f -- "$DEMO_FILE"
      printf '{"ok":true,"demo":false}\n'
      ;;
    *) die "demo takes on or off" ;;
  esac
}

# Invented, but shaped like real work: a session waiting on an approval, one
# that finished unseen, one still going, a stopped one, one on another machine,
# and a machine that cannot be reached.
demo_list() {
  cat <<'DEMO'
{"ok":true,"error":"","machines":[{"id":"m1","label":"buildbox","target":"buildbox","ok":true,"error":""},{"id":"m2","label":"gpu-01","target":"gpu-01","ok":false,"error":"unreachable"}],"sessions":[
{"name":"default","isDefault":true,"running":true,"version":"0.9.1","agents":2,"working":1,"blocked":0,"idle":1,"done":0,"workspaces":2,"projects":["checkout-service","design-tokens"],"agentList":[{"title":"Rewrite the receipt formatter","kind":"claude","status":"working","pane":"w1:p1","workspace":"checkout-service","tab":"Receipts","seq":11},{"title":"Token names for the new palette","kind":"codex","status":"idle","pane":"w2:p1","workspace":"design-tokens","tab":"Palette","seq":9}],"windowId":"{00000000-0000-0000-0000-000000000001}","machineId":"","machineLabel":"","sshTarget":"","remote":false},
{"name":"billing","isDefault":false,"running":true,"version":"0.9.1","agents":1,"working":0,"blocked":1,"idle":0,"done":0,"workspaces":1,"projects":["billing-api"],"agentList":[{"title":"Drop the legacy invoice table","kind":"claude","status":"blocked","pane":"w1:p1","workspace":"billing-api","tab":"Migration","seq":14}],"windowId":"{00000000-0000-0000-0000-000000000002}","machineId":"","machineLabel":"","sshTarget":"","remote":false},
